RTDC_PROVIDER=auto
RTDC_MODEL_BASE_URL=http://localhost:11434/v1
RTDC_MODEL_API_KEY=ollama
RTDC_MODEL_NAME=qwen3:8b
RTDC_MODEL_TIMEOUT_SECONDS=20
RTDC_JSON_MODE=true

RTDC_LOCAL_MODEL_DIR=data/models
RTDC_DEVICE=auto
RTDC_ADMIN_API_KEY=

RTDC_MAX_FILE_MB=20
RTDC_MAX_TOTAL_UPLOAD_MB=50
RTDC_MAX_PDF_PAGES=50
RTDC_MAX_PDF_VISION_PAGES=6
RTDC_PDF_MIN_TEXT_CHARS=100
RTDC_VISION_MODEL=
RTDC_VISION_DEVICE=auto
RTDC_AUDIO_MODEL=tiny
RTDC_AUDIO_DEVICE=cpu
RTDC_AUDIO_COMPUTE_TYPE=int8

# Realtime WebSocket protection. Leave blank only for trusted/local deployments.
RTDC_REALTIME_API_KEY=
RTDC_WS_MAX_MESSAGE_BYTES=1048576

# Optional distributed Map/Reduce. Install with: pip install -e '.[distributed]'
RTDC_REDIS_URL=
RTDC_MAPREDUCE_QUEUE=rtdc:mapreduce:tasks
RTDC_MAPREDUCE_SHARD_SIZE=250
RTDC_MAPREDUCE_JOB_TTL_SECONDS=3600

ROOOM_LICENSE_MODE=personal
# ROOOM_LICENSE_PUBLIC_KEY_B64=
# ROOOM_LICENSE_TOKEN=
