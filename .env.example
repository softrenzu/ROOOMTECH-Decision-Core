RTDC_PROVIDER=auto
RTDC_MODEL_BASE_URL=http://localhost:11434/v1
RTDC_MODEL_API_KEY=ollama
RTDC_MODEL_NAME=qwen3:8b
RTDC_MODEL_TIMEOUT_SECONDS=20
RTDC_JSON_MODE=true

# Local trainable classifier
RTDC_LOCAL_MODEL_DIR=data/models
RTDC_DEVICE=auto
# Set this in any shared/network deployment. If blank, training admin endpoints are unauthenticated.
RTDC_ADMIN_API_KEY=

# Multimodal input limits
RTDC_MAX_FILE_MB=20
RTDC_MAX_TOTAL_UPLOAD_MB=50
RTDC_MAX_PDF_PAGES=50
RTDC_MAX_PDF_VISION_PAGES=6
RTDC_PDF_MIN_TEXT_CHARS=100

# Optional local vision model. No third-party weights are bundled.
# Example only; verify the model/license before production use.
RTDC_VISION_MODEL=
RTDC_VISION_DEVICE=auto

# Optional local speech-to-text model. The model is downloaded by faster-whisper when first used.
RTDC_AUDIO_MODEL=tiny
RTDC_AUDIO_DEVICE=cpu
RTDC_AUDIO_COMPUTE_TYPE=int8

# personal or commercial
ROOOM_LICENSE_MODE=personal

# Required only for commercial mode.
# ROOOM_LICENSE_PUBLIC_KEY_B64=
# ROOOM_LICENSE_TOKEN=
