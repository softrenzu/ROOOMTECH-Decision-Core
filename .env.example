RTDC_PROVIDER=auto
RTDC_MODEL_BASE_URL=http://localhost:11434/v1
RTDC_MODEL_API_KEY=ollama
RTDC_MODEL_NAME=qwen3:8b
RTDC_MODEL_TIMEOUT_SECONDS=20
RTDC_JSON_MODE=true

RTDC_LOCAL_MODEL_DIR=data/models
RTDC_DEVICE=auto
RTDC_ADMIN_API_KEY=

# Decision Studio / calibration / human review / governed datasets.
# If RTDC_STUDIO_API_KEY is blank, RTDC_ADMIN_API_KEY is used as the fallback.
RTDC_STUDIO_API_KEY=
RTDC_REVIEW_DB=data/reviews.sqlite3
RTDC_DATASET_DB=data/datasets.sqlite3

# Guardrail gateway. Falls back to RTDC_REALTIME_API_KEY and then RTDC_ADMIN_API_KEY.
# Under enterprise project-key enforcement, a blank dedicated key uses the project guardrails scope instead.
RTDC_GUARDRAIL_API_KEY=

# Enterprise reference control plane. Disabled by default so existing local deployments keep their behavior.
RTDC_ENTERPRISE_DB=data/enterprise.sqlite3
RTDC_ENTERPRISE_ENFORCE_PROJECT_KEYS=false
# Optional HMAC pepper for stored API-key digests. Keep stable and outside source control in production.
RTDC_ENTERPRISE_KEY_PEPPER=

RTDC_MAX_FILE_MB=20
RTDC_MAX_TOTAL_UPLOAD_MB=50
RTDC_MAX_PDF_PAGES=50
RTDC_MAX_PDF_VISION_PAGES=6
RTDC_PDF_MIN_TEXT_CHARS=100
RTDC_VISION_MODEL=
RTDC_VISION_DEVICE=auto
RTDC_AUDIO_MODEL=tiny
RTDC_AUDIO_DEVICE=cpu
RTDC_AUDIO_COMPUTE_TYPE=int8

# Realtime protection. Leave blank only for trusted/local deployments.
RTDC_REALTIME_API_KEY=
RTDC_WS_MAX_MESSAGE_BYTES=1048576

# Low-latency profile registry and bounded scheduler.
RTDC_FAST_PROFILE_LIMIT=1000
RTDC_FAST_WORKERS=32
RTDC_FAST_QUEUE_CAPACITY=4096
RTDC_FAST_MAX_QUEUE_WAIT_MS=100

# Accelerator-aware local inference. CPU uses bounded direct execution; CUDA micro-batches.
RTDC_LOCAL_BATCH_MAX=64
RTDC_LOCAL_BATCH_WAIT_MS=0.5
RTDC_LOCAL_INFERENCE_QUEUE_CAPACITY=4096
RTDC_GPU_INFERENCE_SLOTS=1
# Defaults to min(8, CPU count) when omitted.
# RTDC_CPU_INFERENCE_SLOTS=8

# Optional Redis support. Install with: pip install -e '.[distributed]'
RTDC_REDIS_URL=
# Enable this when multiple Uvicorn/Gunicorn processes must share dynamically-created fast profiles.
RTDC_FAST_PROFILE_REDIS_ENABLED=false
RTDC_FAST_PROFILE_REDIS_KEY=rtdc:fast:profiles
RTDC_MAPREDUCE_QUEUE=rtdc:mapreduce:tasks
RTDC_MAPREDUCE_SHARD_SIZE=250
RTDC_MAPREDUCE_JOB_TTL_SECONDS=3600

ROOOM_LICENSE_MODE=personal
# ROOOM_LICENSE_PUBLIC_KEY_B64=
# ROOOM_LICENSE_TOKEN=
